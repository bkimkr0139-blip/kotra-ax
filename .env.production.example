# ===== KOTRA AX Portal — production (public URL) =====
PUBLIC_URL=https://kotra-ax2.wizbase.ai.kr
PORT=4400
HOST=127.0.0.1            # bind locally; the reverse proxy (Caddy/nginx/cloudflared) is the only public entry
TRUST_PROXY=true          # trust X-Forwarded-For from the proxy (needed for correct rate-limit / audit IP)
ALLOWED_HOSTS=kotra-ax2.wizbase.ai.kr
DB_PATH=./data/kotra.db

# --- demo exposure controls (read docs/13_DEPLOYMENT.md before enabling) ---
DEMO_MODE=true            # one-click personas. Set false for a hardened, account-only deployment.
DEMO_ACCESS_CODE=         # REQUIRED to allow staff/admin one-click personas on the public URL (choose a long random value)
DEMO_PASSWORD=            # leave empty: a random password is generated on first start and stored in data/.demo-password (0600)
OPEN_API_KEY=             # change from the demo key before exposing /open-api
SESSION_TTL_HOURS=8

# Optional external LLM (otherwise the local evidence-grounded engine runs, labelled LOCAL)
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
DEMO_CLOCK=2026-11-09
API_RATE_LIMIT_PER_MIN=900   # per client IP (behind TRUST_PROXY the real client IP is used)

# AX개발·AXOS (docs/15_AX_DEV_LOOP.md)
AX_DEV_DOCK=true          # false = hide the right-edge AX Dev/AXOS tabs and disable /api/ax*, /api/axos* feedback features
AXOS_WORKER_TOKEN=        # optional: fixed worker token (otherwise issue one in the AXOS console)

# Data Integration Studio (docs/16_DATA_INTEGRATION.md) — synthetic demo data only
DATA_INTEGRATION_STUDIO_ENABLED=true   # false on real production until security/data-access approval
DI_STRICT_SOD=false                    # true = requester, approver and deployer must all differ
